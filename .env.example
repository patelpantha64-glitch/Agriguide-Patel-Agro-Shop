PORT=3000
NODE_ENV=development
DATABASE_FILE=./data/agriguide.sqlite
SHOP_NAME=Patel Agro Shop
# Set a long random secret before production. Never commit a real .env file.
SESSION_SECRET=replace-with-a-long-random-secret
# Payment is intentionally disabled until you configure a real provider such as Razorpay/Stripe.
PAYMENTS_ENABLED=false
